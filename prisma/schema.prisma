// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  target   = "bun"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Auth {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  password   String
  salt       String
  iterations Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auths")
}

model User {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  bio                 String?
  city                String?
  contact             String?
  createdAt           DateTime            @default(now())
  email               String              @unique
  firstName           String
  image               String?
  imagePublicId       String?
  isContactPublic     Boolean?
  isPhonePublic       Boolean?
  lastName            String
  lastSeen            DateTime            @default(now())
  phone               String?
  profileType         UserProfileTypeEnum @default(Guest)
  role                UserRoleEnum        @default(User)
  state               String?
  status              UserStatusEnum      @default(Active)
  updatedAt           DateTime            @updatedAt
  objectId            String?
  passwordUpdateToken String?
  // password         String
  gender              GenderEnum?         @default(Male)
  emailToken          String?
  isEmailVerified     Boolean             @default(false)
  lawSchoolCampus     String?
  townState           String?
  universityCampus    String?
  bookmarks           Bookmark[]
  report_comments     ReportComment[]
  report_likes        ReportLike[]
  reports_added       Report[]            @relation("reports_added")
  reports_updated     Report[]            @relation("reports_updated")

  subscriptions         Subscription[] @relation("UserSubscriptions")
  currentSubscriptionId String?        @unique @db.ObjectId
  currentSubscription   Subscription?  @relation("CurrentSubscription", fields: [currentSubscriptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("users")
}

model Subscription {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId      String                 @db.ObjectId
  reference   String                 @unique
  createdAt   DateTime               @default(now())
  expiresAt   DateTime
  amount      Int
  paymentId   String                 @unique
  plan        SubscriptionPlanEnum   @default(Monthly)
  status      SubscriptionStatusEnum @default(Active)
  user        User                   @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentUser User?                  @relation("CurrentSubscription")

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

model Report {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  body          String
  court         String
  createdAt     DateTime?         @default(now())
  date          DateTime
  isPublished   Boolean           @default(false)
  issues        String?
  ratios        String?
  reportId      Int               @unique
  slug          String            @unique
  suitNo        String
  summary       String
  title         String
  updatedAt     DateTime?         @updatedAt
  added_by_id   String            @db.ObjectId
  updated_by_id String?           @db.ObjectId
  views         Int?              @default(0)
  vol           Int?
  objectId      String?
  tags          ReportTags[]
  lawSubjects   ReportToSubject[]
  visits        ReportVisits[]
  bookmarks     Bookmark[]
  comments      ReportComment[]
  likes         ReportLike[]
  added_by      User              @relation("reports_added", fields: [added_by_id], references: [id])
  updated_by    User?             @relation("reports_updated", fields: [updated_by_id], references: [id])

  @@map("reports")
}

model ReportToSubject {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  reportId  String  @db.ObjectId
  subjectId String  @db.ObjectId
  report    Report  @relation(fields: [reportId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, reportId])
  @@map("_report_to_subject")
}

model ReportComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId  String   @db.ObjectId
  objectId  String?
  comment   String
  createdAt DateTime @default(now())
  reportId  String   @db.ObjectId
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [authorId], references: [id])
  report    Report   @relation(fields: [reportId], references: [id])

  @@map("report_comments")
}

model ReportLike {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  reportId String @db.ObjectId
  userId   String @db.ObjectId
  report   Report @relation(fields: [reportId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
  @@map("report_likes")
}

model ReportTags {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  reportId String @db.ObjectId
  tag      String
  report   Report @relation(fields: [reportId], references: [id])

  @@unique([reportId, tag])
  @@map("_report_tags")
}

model ReportVisits {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  reportId  String @db.ObjectId
  sessionId String
  report    Report @relation(fields: [reportId], references: [id])

  @@unique([reportId, sessionId])
  @@map("_report_visits")
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  reportId  String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reportId])
  @@map("bookmarks")
}

model HandbookCase {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  body       String
  byline     String
  citation   String
  createdAt  DateTime @default(now())
  handbookId String   @db.ObjectId
  ref        Int      @unique
  slug       String   @unique
  title      String
  updatedAt  DateTime @updatedAt
  objectId   String?
  handbooks  Handbook @relation(fields: [handbookId], references: [id])

  @@map("handbook_cases")
}

model Handbook {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime       @default(now())
  slug         String         @unique
  subjectId    String         @db.ObjectId
  topic        String
  updatedAt    DateTime       @updatedAt
  objectId     String?
  handbookCase HandbookCase[]
  subject      Subject        @relation(fields: [subjectId], references: [id])

  @@map("handbooks")
}

model NoteItem {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime            @default(now())
  slug                 String?             @unique
  updatedAt            DateTime            @updatedAt
  objectId             String?
  ref                  Int                 @unique
  question             String
  answer               String
  facultyNoteSummary   FacultyNoteSummary? @relation(fields: [facultyNoteSummaryId], references: [id])
  facultyNoteSummaryId String?             @db.ObjectId
  nlsNoteSummary       NlsNoteSummary?     @relation(fields: [nlsNoteSummaryId], references: [id])
  nlsNoteSummaryId     String?             @db.ObjectId

  @@map("note_items")
}

model Quote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  objectId  String?

  @@map("quotes")
}

model Subject {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime             @default(now())
  intro                String
  name                 String
  slug                 String
  updatedAt            DateTime             @updatedAt
  objectId             String?
  report_to_subject    ReportToSubject[]
  handbooks            Handbook[]
  textbooks            Textbook[]
  facultyNoteSummaries FacultyNoteSummary[]
  nlsNoteSummaries     NlsNoteSummary[]

  @@map("subjects")
}

model FacultyNoteSummary {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  slug      String     @unique
  title     String
  ref       Int
  subjectId String     @db.ObjectId
  note      Subject    @relation(fields: [subjectId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  objectId  String?
  items     NoteItem[]

  @@index([subjectId])
  @@map("faculty_note_summaries")
}

model NlsNoteSummary {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  slug      String     @unique
  title     String
  ref       Int
  subjectId String     @db.ObjectId
  note      Subject    @relation(fields: [subjectId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  objectId  String?
  items     NoteItem[]

  @@index([subjectId])
  @@map("nls_note_summaries")
}

model TextbookCase {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  body       String
  byline     String
  citation   String
  createdAt  DateTime @default(now())
  ref        Int      @unique
  slug       String   @unique
  title      String
  updatedAt  DateTime @updatedAt
  textbookId String   @db.ObjectId
  textbooks  Textbook @relation(fields: [textbookId], references: [id])

  @@map("textbook_cases")
}

model Textbook {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime       @default(now())
  slug         String         @unique
  subjectId    String         @db.ObjectId
  topic        String
  updatedAt    DateTime       @updatedAt
  objectId     String?
  textbookCase TextbookCase[]
  subject      Subject        @relation(fields: [subjectId], references: [id])

  @@map("textbooks")
}

enum GenderEnum {
  Male
  Female
}

enum UserProfileTypeEnum {
  Student
  Lawyer
  Guest
  Staff

  @@map("UserProfileType")
}

enum UserRoleEnum {
  Admin
  Editor
  User
  Developer
}

enum UserStatusEnum {
  Active
  Suspended
  Banned
}

enum SubscriptionPlanEnum {
  Monthly
  Yearly
}

enum SubscriptionStatusEnum {
  Active
  Expired
}
