generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["fullTextSearchPostgres"]
  target          = "bun"
}

datasource db {
  provider = "postgresql"
}

model Auth {
  id         String   @id @default(cuid())
  userId     String   @unique
  password   String
  salt       String
  iterations Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auths")
}

model User {
  id                    String               @id @default(cuid())
  bio                   String?
  city                  String?
  contact               String?
  createdAt             DateTime             @default(now())
  email                 String               @unique
  firstName             String
  image                 String?
  imagePublicId         String?
  isContactPublic       Boolean?
  isPhonePublic         Boolean?
  lastName              String
  lastSeen              DateTime             @default(now())
  phone                 String?
  profileType           UserProfileTypeEnum  @default(Guest)
  role                  UserRoleEnum         @default(User)
  state                 String?
  status                UserStatusEnum       @default(Active)
  updatedAt             DateTime             @updatedAt
  objectId              String?
  passwordUpdateToken   String?
  gender                GenderEnum?          @default(Male)
  emailToken            String?
  isEmailVerified       Boolean              @default(false)
  currentSubscriptionId String?              @unique
  organizationId        String?
  permissions           String[]             @default([])
  bookmarks             Bookmark[]
  payments              PaymentTransaction[]
  ReportCommentLike     ReportCommentLike[]
  report_comments       ReportComment[]
  report_likes          ReportLike[]
  reports_added         Report[]             @relation("reports_added")
  reports_updated       Report[]             @relation("reports_updated")
  subscriptions         Subscription[]       @relation("UserSubscriptions")
  currentSubscription   Subscription?        @relation("CurrentSubscription", fields: [currentSubscriptionId], references: [id], onUpdate: NoAction)
  organization          Organization?        @relation(fields: [organizationId], references: [id])

  @@map("users")
}

model Subscription {
  id                        String                     @id @default(cuid())
  userId                    String?
  reference                 String                     @unique
  createdAt                 DateTime                   @default(now())
  expiresAt                 DateTime?
  amount                    Int?
  paymentId                 String?                    @unique
  autoRenew                 Boolean                    @default(true)
  canceledReason            String?
  cancelledAt               DateTime?
  currency                  String                     @default("NGN")
  currentPeriodEnd          DateTime?
  currentPeriodStart        DateTime?
  meta                      Json?
  nextBillingAt             DateTime?
  organizationId            String?
  provider                  String?
  providerCustomerId        String?
  providerPlanId            String?
  providerSubscriptionId    String?                    @unique
  startsAt                  DateTime?
  trialEndsAt               DateTime?
  status                    SubscriptionStatusEnum     @default(Pending)
  plan                      PlanIntervalEnum           @default(monthly)
  planCode                  String?
  subscriptionPlanId        Int?
  emailToken                String?
  updatedAt                 DateTime?                  @updatedAt
  organizationSubscriptions OrganizationSubscription[]
  payments                  PaymentTransaction[]
  organization              Organization?              @relation(fields: [organizationId], references: [id])
  subscriptionPlan          SubscriptionPlan?          @relation(fields: [subscriptionPlanId], references: [id])
  user                      User?                      @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentUser               User?                      @relation("CurrentSubscription")

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@index([nextBillingAt])
  @@map("subscriptions")
}

model Report {
  id            String            @id @default(cuid())
  body          String
  court         String
  createdAt     DateTime?         @default(now())
  date          DateTime
  isPublished   Boolean           @default(false)
  issues        String?
  ratios        String?
  reportId      Int               @unique
  slug          String            @unique
  suitNo        String
  summary       String
  title         String
  updatedAt     DateTime?         @updatedAt
  added_by_id   String
  updated_by_id String?
  views         Int?              @default(0)
  vol           Int?
  objectId      String?
  tags          ReportTags[]
  lawSubjects   ReportToSubject[]
  visits        ReportVisits[]
  bookmarks     Bookmark[]
  comments      ReportComment[]
  likes         ReportLike[]
  added_by      User              @relation("reports_added", fields: [added_by_id], references: [id])
  updated_by    User?             @relation("reports_updated", fields: [updated_by_id], references: [id])

  @@map("reports")
}

model ReportToSubject {
  id        String  @id @default(cuid())
  reportId  String
  subjectId String
  report    Report  @relation(fields: [reportId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, reportId])
  @@map("_report_to_subject")
}

model ReportComment {
  id        String              @id @default(cuid())
  authorId  String
  objectId  String?
  comment   String
  createdAt DateTime            @default(now())
  reportId  String
  updatedAt DateTime            @updatedAt
  likes     ReportCommentLike[]
  user      User                @relation(fields: [authorId], references: [id])
  report    Report              @relation(fields: [reportId], references: [id])

  @@map("report_comments")
}

model ReportCommentLike {
  id              String        @id @default(cuid())
  reportCommentId String
  userId          String
  reportComment   ReportComment @relation(fields: [reportCommentId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([reportCommentId, userId])
  @@map("report_comment_likes")
}

model ReportLike {
  id       String @id @default(cuid())
  reportId String
  userId   String
  report   Report @relation(fields: [reportId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
  @@map("report_likes")
}

model ReportTags {
  id       String @id @default(cuid())
  reportId String
  tag      String
  report   Report @relation(fields: [reportId], references: [id])

  @@unique([reportId, tag])
  @@map("_report_tags")
}

model ReportVisits {
  reportId  String
  sessionId String
  report    Report @relation(fields: [reportId], references: [id])

  @@unique([reportId, sessionId])
  @@map("_report_visits")
}

model Bookmark {
  userId    String
  reportId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reportId])
  @@map("bookmarks")
}

model Quote {
  id        String   @id @default(cuid())
  text      String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  objectId  String?

  @@map("quotes")
}

model Subject {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  intro             String
  name              String
  slug              String            @unique
  updatedAt         DateTime          @updatedAt
  objectId          String?
  report_to_subject ReportToSubject[]
  finalBarExamQAs   FinalBarExamQA[]
  handbookTopics    HandbookTopic[]
  summaryTopics     SummaryTopic[]

  @@map("subjects")
}

model HandbookTopic {
  id        String         @id @default(cuid())
  title     String         @unique
  slug      String?
  subjectId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  type      TopicTypeEnum  @default(Handbook)
  cases     HandbookCase[]
  subject   Subject        @relation(fields: [subjectId], references: [id])

  @@map("handbook_topics")
}

model HandbookCase {
  id        String        @id @default(cuid())
  body      String
  byline    String
  citation  String
  createdAt DateTime      @default(now())
  ref       Int           @unique
  slug      String?
  title     String
  updatedAt DateTime      @updatedAt
  topicId   String
  topic     HandbookTopic @relation(fields: [topicId], references: [id])

  @@map("handbook_cases")
}

model SummaryTopic {
  id        String          @id @default(cuid())
  title     String          @unique
  slug      String
  subjectId String
  type      SummaryTypeEnum @default(Faculty_Summary)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cases     SummaryCase[]
  subject   Subject         @relation(fields: [subjectId], references: [id])

  @@map("summary_topics")
}

model SummaryCase {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  topicId   String
  slug      String?
  ref       Int          @unique
  question  String
  answer    String
  updatedAt DateTime     @updatedAt
  objectId  String?
  topic     SummaryTopic @relation(fields: [topicId], references: [id])

  @@map("summary_cases")
}

model Organization {
  id                        String                     @id @default(cuid())
  name                      String                     @unique
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  organizationSubscriptions OrganizationSubscription[]
  payments                  PaymentTransaction[]
  subscriptions             Subscription[]
  users                     User[]

  @@map("schools")
}

model PaymentTransaction {
  id                    String            @id @default(cuid())
  userId                String?
  subscriptionId        String?
  organizationId        String?
  provider              String
  providerTransactionId String?
  reference             String?
  amount                Int
  currency              String            @default("NGN")
  status                PaymentStatusEnum
  type                  PaymentTypeEnum
  response              Json?
  createdAt             DateTime          @default(now())
  organization          Organization?     @relation(fields: [organizationId], references: [id])
  subscription          Subscription?     @relation(fields: [subscriptionId], references: [id])
  user                  User?             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@map("payment_transactions")
}

model OrganizationSubscription {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  seatsTotal     Int
  seatsAssigned  Int           @default(0)
  createdAt      DateTime      @default(now())
  expiresAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("organization_subscriptions")
}

model SubscriptionPlan {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  planCode      String           @unique
  amount        Int
  integration   Int
  domain        String           @default("test")
  currency      String           @default("NGN")
  interval      PlanIntervalEnum @default(monthly)
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  isActive      Boolean          @default(true)
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model FinalBarExamQA {
  id        String   @id @default(cuid())
  subjectId String
  question  String
  answer    String
  year      Int?
  ref       Int?     @unique
  slug      String?  @unique
  createdBy String   @default("admin")
  updatedBy String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id])

  @@map("final_bar_exam_qa")
}

enum PlanIntervalEnum {
  daily
  weekly
  monthly
  quarterly
  biannually
  annually
}

enum GenderEnum {
  Male
  Female
}

enum UserProfileTypeEnum {
  Student
  Lawyer
  Guest
  Staff
  User

  @@map("UserProfileType")
}

enum UserRoleEnum {
  Admin
  Editor
  User
  Developer
  SuperAdmin
}

enum UserStatusEnum {
  Active
  Suspended
  Banned
}

enum SubscriptionPlanEnum {
  Monthly
  Yearly
}

enum SubscriptionStatusEnum {
  Active
  Expired
  Pending
  Trialing
  PastDue
  Cancelled
  Paused
}

enum PaymentStatusEnum {
  Pending
  Paid
  Failed
  Refunded
}

enum PaymentTypeEnum {
  Initial
  Renewal
  Refund
}

enum TopicTypeEnum {
  Textbook @map("Textbook")
  Handbook @map("Handbook")
}

enum SummaryTypeEnum {
  Faculty_Summary   @map("Faculty Summary")
  NLS_Summary       @map("NLS Summary")
  Final_Bar_Exam_QA @map("Final Bar Exam Questions and Answers")
}
