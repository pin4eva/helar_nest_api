model Quote {
  id        String   @id @default(cuid())
  text      String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  objectId  String?

  @@map("quotes")
}

model Subject {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  intro             String
  name              String
  slug              String            @unique
  updatedAt         DateTime          @updatedAt
  objectId          String?
  report_to_subject ReportToSubject[]
  // handbooks            Handbook[]
  // textbooks            Textbook[]
  // facultyNoteSummaries FacultyNoteSummary[]
  // nlsNoteSummaries     NlsNoteSummary[]
  handbookTopics    HandbookTopic[]
  summaryTopics     SummaryTopic[]

  @@map("subjects")
}

