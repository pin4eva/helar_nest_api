model HandbookTopic {
  id        String         @id @default(cuid())
  title     String         @unique
  slug      String?
  subjectId String
  type      TopicTypeEnum  @default(Handbook)
  subject   Subject        @relation(fields: [subjectId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cases     HandbookCase[]

  @@map("handbook_topics")
}

model HandbookCase {
  id        String         @id @default(cuid())
  body      String
  byline    String
  citation  String
  createdAt DateTime       @default(now())
  topicId   String
  ref       Int            @unique
  slug      String?
  title     String
  updatedAt DateTime       @updatedAt
  topic     HandbookTopic? @relation(fields: [topicId], references: [id])

  @@map("handbook_cases")
}

model SummaryTopic {
  id        String          @id @default(cuid())
  title     String          @unique
  slug      String
  subjectId String
  type      SummaryTypeEnum @default(Faculty_Summary)
  subject   Subject         @relation(fields: [subjectId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cases     SummaryCase[]

  @@map("summary_topics")
}

model SummaryCase {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  topicId   String
  slug      String?
  ref       Int           @unique
  question  String
  answer    String
  updatedAt DateTime      @updatedAt
  objectId  String?
  topic     SummaryTopic? @relation(fields: [topicId], references: [id])

  @@map("summary_cases")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("schools")
}

enum GenderEnum {
  Male
  Female
}

enum UserProfileTypeEnum {
  Student
  Lawyer
  Guest
  User
  Staff

  @@map("UserProfileType")
}

enum UserRoleEnum {
  Admin
  Editor
  User
  Developer
  SuperAdmin
}

enum UserStatusEnum {
  Active
  Suspended
  Banned
}

enum SubscriptionPlanEnum {
  Monthly
  Yearly
}

enum SubscriptionStatusEnum {
  Active
  Expired
}

enum TopicTypeEnum {
  Textbook @map("Textbook")
  Handbook @map("Handbook")
}

enum SummaryTypeEnum {
  Faculty_Summary   @map("Faculty Summary")
  NLS_Summary       @map("NLS Summary")
  Final_Bar_Exam_QA @map("Final Bar Exam Questions and Answers")
}
