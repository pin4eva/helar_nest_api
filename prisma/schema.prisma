generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  target          = "bun"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Auth {
  id         String   @id @default(cuid())
  userId     String   @unique
  password   String
  salt       String
  iterations Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auths")
}

model User {
  id                  String              @id @default(cuid())
  bio                 String?
  city                String?
  contact             String?
  createdAt           DateTime            @default(now())
  email               String              @unique
  firstName           String
  image               String?
  imagePublicId       String?
  isContactPublic     Boolean?
  isPhonePublic       Boolean?
  lastName            String
  lastSeen            DateTime            @default(now())
  phone               String?
  permissions         String[]            @default([])
  profileType         UserProfileTypeEnum @default(Guest)
  role                UserRoleEnum        @default(User)
  state               String?
  status              UserStatusEnum      @default(Active)
  updatedAt           DateTime            @updatedAt
  objectId            String?
  passwordUpdateToken String?
  // password         String
  gender              GenderEnum?         @default(Male)
  emailToken          String?
  isEmailVerified     Boolean             @default(false)
  organizationId      String?
  bookmarks           Bookmark[]
  report_comments     ReportComment[]
  report_likes        ReportLike[]
  reports_added       Report[]            @relation("reports_added")
  reports_updated     Report[]            @relation("reports_updated")

  subscriptions         Subscription[]      @relation("UserSubscriptions")
  currentSubscriptionId String?             @unique
  currentSubscription   Subscription?       @relation("CurrentSubscription", fields: [currentSubscriptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ReportCommentLike     ReportCommentLike[]
  organization          Organization?       @relation(fields: [organizationId], references: [id])

  @@map("users")
}

model Subscription {
  id          String                 @id @default(cuid())
  userId      String
  reference   String                 @unique
  createdAt   DateTime               @default(now())
  expiresAt   DateTime
  amount      Int
  paymentId   String                 @unique
  plan        SubscriptionPlanEnum   @default(Monthly)
  status      SubscriptionStatusEnum @default(Active)
  user        User                   @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentUser User?                  @relation("CurrentSubscription")

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

model Report {
  id            String            @id @default(cuid())
  body          String
  court         String
  createdAt     DateTime?         @default(now())
  date          DateTime
  isPublished   Boolean           @default(false)
  issues        String?
  ratios        String?
  reportId      Int               @unique
  slug          String            @unique
  suitNo        String
  summary       String
  title         String
  updatedAt     DateTime?         @updatedAt
  added_by_id   String
  updated_by_id String?
  views         Int?              @default(0)
  vol           Int?
  objectId      String?
  tags          ReportTags[]
  lawSubjects   ReportToSubject[]
  visits        ReportVisits[]
  bookmarks     Bookmark[]
  comments      ReportComment[]
  likes         ReportLike[]
  added_by      User              @relation("reports_added", fields: [added_by_id], references: [id])
  updated_by    User?             @relation("reports_updated", fields: [updated_by_id], references: [id])

  @@map("reports")
}

model ReportToSubject {
  id        String  @id @default(cuid())
  reportId  String
  subjectId String
  report    Report  @relation(fields: [reportId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, reportId])
  @@map("_report_to_subject")
}

model ReportComment {
  id        String              @id @default(cuid())
  authorId  String
  objectId  String?
  comment   String
  createdAt DateTime            @default(now())
  reportId  String
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [authorId], references: [id])
  report    Report              @relation(fields: [reportId], references: [id])
  likes     ReportCommentLike[]

  @@map("report_comments")
}

model ReportCommentLike {
  id              String        @id @default(cuid())
  reportCommentId String
  userId          String
  reportComment   ReportComment @relation(fields: [reportCommentId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([reportCommentId, userId])
  @@map("report_comment_likes")
}

model ReportLike {
  id       String @id @default(cuid())
  reportId String
  userId   String
  report   Report @relation(fields: [reportId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
  @@map("report_likes")
}

model ReportTags {
  id       String @id @default(cuid())
  reportId String
  tag      String
  report   Report @relation(fields: [reportId], references: [id])

  @@unique([reportId, tag])
  @@map("_report_tags")
}

model ReportVisits {
  reportId  String
  sessionId String
  report    Report @relation(fields: [reportId], references: [id])

  @@unique([reportId, sessionId])
  @@map("_report_visits")
}

model Bookmark {
  userId    String
  reportId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reportId])
  @@map("bookmarks")
}

