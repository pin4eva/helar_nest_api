# MongoDB Connection String (for direct connection)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# Optional: Direct URL for migrations (same as DATABASE_URL for MongoDB)
DIRECT_DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# Or use Prisma Accelerate (recommended for Vercel)
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"
# DIRECT_DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# Server Port (optional, defaults to 8000)
PORT=8000

# Node Environment
NODE_ENV=development
